---
import Layout from '@layouts/Layout.astro';

const currentPath = Astro.url.pathname;
---

<Layout title="404: Not Found" noindex>
  <main class="site-main not-found">
    <p class="not-found-code" aria-hidden="true" data-reveal data-reveal-delay="0">404</p>
    <div class="not-found-copy" data-reveal data-reveal-delay="1">
      <p class="eyebrow">Page not found</p>
      <h1>This page took a wrong turn.</h1>
      <p>The link may be broken, or the page may have moved. Nothing here needs fixing on your end.</p>
      <p class="not-found-path"><span>Path</span><code>{currentPath}</code></p>
    </div>
    <div class="intro-actions" data-reveal data-reveal-delay="2">
      <a class="button button-primary" href="/">Back to home <span aria-hidden="true">←</span></a>
      <a class="button" href="/#projects">View selected work <span aria-hidden="true">↓</span></a>
    </div>
  </main>
</Layout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: min(70vh, 40rem);
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .not-found-code {
    margin: 0;
    color: var(--color-border-accent);
    font-size: clamp(6rem, 22vw, 14rem);
    font-weight: 800;
    letter-spacing: -0.08em;
    line-height: 0.85;
    user-select: none;
  }

  .not-found-copy {
    max-width: 38rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .not-found h1 {
    margin: 0.5rem 0 1rem;
    color: var(--color-text);
    font-size: clamp(1.9rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1.08;
  }

  .not-found-copy > p:not(.eyebrow):not(.not-found-path) {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .not-found-path {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin: 1.75rem 0 0;
    font-size: 0.78rem;
  }

  .not-found-path span {
    color: var(--brand-primary-300);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .not-found-path code {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-border-accent);
    color: var(--color-text-muted);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
</style>
