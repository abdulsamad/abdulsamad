---
import projects from '@data/projects.json';
import { githubProfileUrl } from '@utils/github';
---

<section class="projects" aria-labelledby="projects-title" data-analytics-section="projects">
  <div class="section-heading">
    <div><p class="eyebrow">Selected work</p><h2 id="projects-title">Selected projects</h2></div><a
      class="section-link"
      href={githubProfileUrl}
      target="_blank"
      rel="noopener">View all <span aria-hidden="true">↗</span></a>
  </div>
  <div class="project-grid" id="project-grid">
    {
      projects.map((project, index) => (
        <article
          class="project-card"
          data-project-card
          data-project-repo={project.slug}
          role="button"
          tabindex="0"
          aria-label={`Open details for ${project.name}`}>
          <>
            <div class="project-card-top">
              <span class="project-index">0{index + 1}</span>
              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener"
                  aria-label={`View ${project.name} on GitHub`}>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
          </>
        </article>
      ))
    }
  </div>
  <dialog class="project-modal" id="project-modal" aria-labelledby="project-modal-title">
    <button
      class="project-modal-close"
      type="submit"
      form="project-modal-form"
      aria-label="Close project details"><span aria-hidden="true">×</span></button
    ><form class="project-modal-shell" id="project-modal-form" method="dialog">
      <header class="project-modal-header">
        <p class="eyebrow">Project details</p><h2 id="project-modal-title" data-project-modal-title>
        </h2><p data-project-modal-description></p><div class="project-modal-actions">
          <a data-project-modal-homepage target="_blank" rel="noopener" hidden
            >Live site <span aria-hidden="true">↗</span></a
          ><a data-project-modal-github target="_blank" rel="noopener" hidden
            >GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </header><div class="project-readme" data-project-details aria-live="polite">
        <h3>Highlights</h3><ul data-project-highlights></ul><h3>Problem solved</h3><p
          data-project-problem>
        </p><h3>Architecture</h3><p data-project-architecture></p><h3>Technologies</h3><ul
          data-project-technologies>
        </ul>
      </div>
    </form>
  </dialog>
</section>

<script>
  import { navigate } from 'astro:transitions/client';
  import projectData from '@data/projects.json';
  let activeProject = '';

  const initialiseProjectModal = () => {
    const grid = document.querySelector<HTMLElement>('#project-grid');
    const section = document.querySelector<HTMLElement>('.projects');
    const modal = document.querySelector<HTMLDialogElement>('#project-modal');
    const title = modal?.querySelector<HTMLElement>('[data-project-modal-title]');
    const description = modal?.querySelector<HTMLElement>('[data-project-modal-description]');
    const homepage = modal?.querySelector<HTMLAnchorElement>('[data-project-modal-homepage]');
    const github = modal?.querySelector<HTMLAnchorElement>('[data-project-modal-github]');
    const highlights = modal?.querySelector<HTMLElement>('[data-project-highlights]');
    const problem = modal?.querySelector<HTMLElement>('[data-project-problem]');
    const architecture = modal?.querySelector<HTMLElement>('[data-project-architecture]');
    const technologies = modal?.querySelector<HTMLElement>('[data-project-technologies]');
    if (
      !grid ||
      !section ||
      !modal ||
      !title ||
      !description ||
      !homepage ||
      !github ||
      !highlights ||
      !problem ||
      !architecture ||
      !technologies
    )
      return;

    const openProject = (slug: string, method: 'card' | 'deep_link') => {
      const project = projectData.find((item) => item.slug === slug);
      if (!project) return;
      activeProject = project.slug;
      title.textContent = project.name;
      description.textContent = project.description;
      homepage.hidden = !project.homepageUrl;
      if (project.homepageUrl) homepage.href = project.homepageUrl;
      github.hidden = !project.githubUrl;
      if (project.githubUrl) github.href = project.githubUrl;
      const renderList = (element: HTMLElement, items: string[]) =>
        element.replaceChildren(
          ...items.map((text) => {
            const item = document.createElement('li');
            item.textContent = text;
            return item;
          })
        );
      renderList(highlights, project.details.highlights);
      problem.textContent = project.details.problem;
      architecture.textContent = project.details.architecture;
      renderList(technologies, project.details.technologies);
      if (!modal.open) modal.showModal();
      document.documentElement.classList.add('project-modal-open');
      window.portfolioAnalytics?.capture('portfolio_project_details_opened', {
        project_slug: project.slug,
        interaction_method: method,
      });
    };

    if (new URL(window.location.href).searchParams.get('project'))
      openProject(new URL(window.location.href).searchParams.get('project')!, 'deep_link');
    if (!grid.dataset.modalReady) {
      grid.dataset.modalReady = 'true';
      grid.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('a')) return;
        const slug = target.closest<HTMLElement>('[data-project-card]')?.dataset.projectRepo;
        if (slug) navigate(`${window.location.pathname}?project=${encodeURIComponent(slug)}`);
      });
      grid.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        const target = event.target as HTMLElement;
        if (target.closest('a')) return;
        const slug = target.closest<HTMLElement>('[data-project-card]')?.dataset.projectRepo;
        if (slug) {
          event.preventDefault();
          navigate(`${window.location.pathname}?project=${encodeURIComponent(slug)}`);
        }
      });
    }
    if (!modal.dataset.modalReady) {
      modal.dataset.modalReady = 'true';
      modal.addEventListener('click', (event) => {
        if (event.target === modal) modal.close();
      });
      modal.addEventListener('close', () => {
        activeProject = '';
        document.documentElement.classList.remove('project-modal-open');
        if (new URL(window.location.href).searchParams.has('project'))
          navigate(window.location.pathname);
      });
    }
  };
  initialiseProjectModal();
  document.addEventListener('astro:page-load', initialiseProjectModal);
</script>
