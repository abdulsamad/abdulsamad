---
const PUBLIC_POSTHOG_KEY = import.meta.env.PUBLIC_POSTHOG_KEY;
const PUBLIC_POSTHOG_HOST = '/zen-route';
const PUBLIC_POSTHOG_UI_HOST = import.meta.env.PUBLIC_POSTHOG_UI_HOST;
---

<script define:vars={{ PUBLIC_POSTHOG_KEY, PUBLIC_POSTHOG_HOST, PUBLIC_POSTHOG_UI_HOST }} is:inline>
  if (!window.__posthog_initialized) {
    window.__posthog_initialized = true;

    const posthog = (window.posthog = window.posthog || []);
    posthog._i = posthog._i || [];
    const posthogMethods = 'capture identify alias people.set people.set_once register register_once unregister opt_out_capturing opt_in_capturing reset'.split(' ');
    posthogMethods.forEach((method) => {
      posthog[method] = (...args) => posthog.push([method, ...args]);
    });
    posthog.init = function (key, options, name) {
      const instance = name ? (posthog[name] = []) : posthog;
      instance._i = instance._i || [];
      posthog._i.push([key, options, name]);
      const script = document.createElement('script');
      script.async = true;
      script.src = `${options.api_host}/static/array.js`;
      document.head.appendChild(script);
    };
    posthog.init(PUBLIC_POSTHOG_KEY, {
      api_host: PUBLIC_POSTHOG_HOST,
      ui_host: PUBLIC_POSTHOG_UI_HOST,
      person_profiles: 'always',
      capture_pageview: 'history_change',
      capture_pageleave: true,
      capture_exceptions: true,
      session_recording: { maskAllInputs: false },
    });

    const attribution = () => {
      const params = new URLSearchParams(window.location.search);
      return Object.fromEntries(
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].flatMap((key) => {
          const value = params.get(key);
          return value ? [[key, value]] : [];
        })
      );
    };

    const capturePortfolioEvent = (eventName, properties = {}) => {
      posthog.capture(eventName, {
        ...attribution(),
        page_path: window.location.pathname,
        viewport: `${window.innerWidth}x${window.innerHeight}`,
        ...properties,
      });
    };

    window.portfolioAnalytics = {
      capture: capturePortfolioEvent,
      headers: () => {
        const distinctId = typeof posthog.get_distinct_id === 'function' ? posthog.get_distinct_id() : '';
        const sessionId = typeof posthog.get_session_id === 'function' ? posthog.get_session_id() : '';
        return {
          ...(distinctId ? { 'X-PostHog-Distinct-Id': distinctId } : {}),
          ...(sessionId ? { 'X-PostHog-Session-Id': sessionId } : {}),
        };
      },
    };

    capturePortfolioEvent('portfolio_landing_viewed', { entry_type: performance.getEntriesByType('navigation')[0]?.type ?? 'navigate' });

    const sections = document.querySelectorAll('[data-analytics-section]');
    if ('IntersectionObserver' in window) {
      const seenSections = new Set();
      const observer = new IntersectionObserver(
        (entries) => entries.forEach((entry) => {
          const section = entry.target.getAttribute('data-analytics-section');
          if (!entry.isIntersecting || !section || seenSections.has(section)) return;
          seenSections.add(section);
          capturePortfolioEvent('portfolio_section_viewed', { section });
        }),
        { threshold: 0.35 }
      );
      sections.forEach((section) => observer.observe(section));
    }

    const depthThresholds = [25, 50, 75, 100];
    const seenDepths = new Set();
    const captureDepth = () => {
      const height = document.documentElement.scrollHeight - window.innerHeight;
      const depth = height <= 0 ? 100 : Math.round((window.scrollY / height) * 100);
      depthThresholds.forEach((threshold) => {
        if (depth >= threshold && !seenDepths.has(threshold)) {
          seenDepths.add(threshold);
          capturePortfolioEvent('portfolio_scroll_depth_reached', { depth_percent: threshold });
        }
      });
    };
    window.addEventListener('scroll', captureDepth, { passive: true });
    captureDepth();

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest('[data-track]') : null;
      if (!target) return;

      const eventName = target.getAttribute('data-track');
      if (!eventName) return;

      const properties = {};
      target.getAttributeNames().forEach((attribute) => {
        if (!attribute.startsWith('data-track-')) return;
        properties[attribute.replace('data-track-', '')] = target.getAttribute(attribute);
      });
      capturePortfolioEvent(eventName, properties);
    });
  }
</script>
